# ClinicCare Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret-before-production
CLINIC_TIMEZONE=Asia/Kolkata
ALLOW_DEV_TOKENS=false

# Firebase Admin Configuration
# Option A: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Direct Firebase credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# WhatsApp Business Cloud API Configuration (for Phase 7 integration)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# OCR API Configuration (e.g. Google Cloud Vision or Tesseract)
OCR_ENABLED=true

