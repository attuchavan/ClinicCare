# ClinicCare Client Environment Variables
# Use /api for same-origin Vercel deployments or http://localhost:5000/api locally
VITE_API_URL=/api
VITE_ENABLE_DEMO_LOGIN=false

# Firebase Web Client Configuration (Optional: demo fallback works automatically if blank)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

